# Copy to .env or export in your shell.
# Leave these empty to run in DEMO MODE with built-in sample store data
# (no real Shopify store needed).

# Your store domain, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token from Shopify admin:
# Settings > Apps and sales channels > Develop apps > Create an app >
# Configure Admin API scopes (read_products, write_products, read_orders,
# read_customers, read_inventory) > Install app > Reveal token once
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Admin API version (optional, defaults to 2025-01)
SHOPIFY_API_VERSION=2025-01
